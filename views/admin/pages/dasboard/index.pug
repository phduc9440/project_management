extends ../../layouts/default.pug

block main
    .page-header
        h1
            i.fas.fa-chart-pie(style="color:#0f766e;")
            | Tổng quan

    //- Profile card
    .row.mb-4
        .col-12
            .card
                .card-header
                    i.fas.fa-user-circle(style="color:#0f766e;")
                    | Thông tin tài khoản
                .card-body
                    .d-flex.align-items-center(style="gap:20px;flex-wrap:wrap;")
                        if (user.avatar)
                            img(
                                src=user.avatar
                                style="width:80px;height:80px;border-radius:50%;object-fit:cover;border:3px solid #dfe6e3;"
                            )
                        div
                            if (user.fullName)
                                p(style="margin:0 0 4px;font-size:15px;") Họ tên: 
                                    strong #{user.fullName}
                            if (user.email)
                                p(style="margin:0 0 4px;font-size:14px;color:#5d6f69;") Email: 
                                    strong #{user.email}
                            if (user.phone)
                                p(style="margin:0 0 4px;font-size:14px;color:#5d6f69;") Điện thoại: 
                                    strong #{user.phone}
                            if (role.title)
                                span(style="display:inline-block;background:rgba(15,118,110,.1);color:#0f766e;border:1px solid rgba(15,118,110,.25);border-radius:20px;padding:3px 12px;font-size:12px;font-weight:600;margin-top:4px;")
                                    i.fas.fa-shield-halved(style="margin-right:4px;")
                                    | #{role.title}

    //- Statistics
    .row
        .col-md-6.col-lg-3.mb-4
            .stat-card
                .stat-icon.primary
                    i.fas.fa-tags
                .stat-info
                    .stat-label Danh mục sản phẩm
                    .stat-value #{statistic.categoryProduct.total}
                    .stat-meta
                        span(style="color:#10b981;font-weight:600;") #{statistic.categoryProduct.active} hoạt động
                        |  · 
                        span(style="color:#ef4444;") #{statistic.categoryProduct.inactive} dừng

        .col-md-6.col-lg-3.mb-4
            .stat-card
                .stat-icon.success
                    i.fas.fa-box-open
                .stat-info
                    .stat-label Sản phẩm
                    .stat-value #{statistic.product.total}
                    .stat-meta
                        span(style="color:#10b981;font-weight:600;") #{statistic.product.active} hoạt động
                        |  · 
                        span(style="color:#ef4444;") #{statistic.product.inactive} dừng

        .col-md-6.col-lg-3.mb-4
            .stat-card
                .stat-icon.warning
                    i.fas.fa-user-tie
                .stat-info
                    .stat-label Tài khoản Admin
                    .stat-value #{statistic.account.total}
                    .stat-meta
                        span(style="color:#10b981;font-weight:600;") #{statistic.account.active} hoạt động
                        |  · 
                        span(style="color:#ef4444;") #{statistic.account.inactive} dừng

        .col-md-6.col-lg-3.mb-4
            .stat-card
                .stat-icon.info
                    i.fas.fa-users
                .stat-info
                    .stat-label Tài khoản Client
                    .stat-value #{statistic.user.total}
                    .stat-meta
                        span(style="color:#10b981;font-weight:600;") #{statistic.user.active} hoạt động
                        |  · 
                        span(style="color:#ef4444;") #{statistic.user.inactive} dừng
