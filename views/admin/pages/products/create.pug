extends ../../layouts/default.pug
include ../../mixins/alert.pug
include ../../mixins/select-tree.pug

block main
    if (role.permissions.includes("products-create"))
        +alert-error(5000)
        +alert-success(5000)

        .page-header
            h1
                i.fas.fa-plus-circle(style="color:#0f766e;")
                | Thêm mới sản phẩm
            a(href=`${prefixAdmin}/products` class="btn btn-secondary")
                i.fas.fa-arrow-left
                | Quay lại

        .card
            .card-body
                form(
                    action=`${prefixAdmin}/products/create`
                    id="form-create-product"
                    method="POST"
                    enctype="multipart/form-data"
                )
                    .row
                        .col-md-8
                            div(class="form-group")
                                label(for="title")
                                    i.fas.fa-heading(style="margin-right:5px;color:#0f766e;font-size:12px;")
                                    | Tiêu đề
                                input(
                                    type="text"
                                    class="form-control"
                                    id="title"
                                    name="title"
                                    placeholder="Nhập tiêu đề sản phẩm..."
                                    required
                                )

                            div(class="form-group")
                                label(for="product_category_id")
                                    i.fas.fa-tag(style="margin-right:5px;color:#0f766e;font-size:12px;")
                                    | Danh mục
                                select(
                                    name="product_category_id"
                                    id="product_category_id"
                                    class="form-control"
                                )
                                    option(value="") -- Chọn danh mục --
                                    if (category)
                                        +select-tree(category)

                            div(class="form-group")
                                label
                                    i.fas.fa-star(style="margin-right:5px;color:#f59e0b;font-size:12px;")
                                    | Nổi bật
                                div(style="display:flex;gap:20px;margin-top:6px;")
                                    label(style="display:flex;align-items:center;gap:6px;cursor:pointer;")
                                        input(
                                            type="radio"
                                            class="form-check-input"
                                            id="featured1"
                                            name="featured"
                                            value="1"
                                            style="margin:0;"
                                        )
                                        span Nổi bật
                                    label(style="display:flex;align-items:center;gap:6px;cursor:pointer;")
                                        input(
                                            type="radio"
                                            class="form-check-input"
                                            id="featured0"
                                            name="featured"
                                            value="0"
                                            checked
                                            style="margin:0;"
                                        )
                                        span Không

                            div(class="form-group")
                                label(for="desc")
                                    i.fas.fa-align-left(style="margin-right:5px;color:#0f766e;font-size:12px;")
                                    | Mô tả
                                textarea(
                                    class="form-control textarea-mce"
                                    id="desc"
                                    name="description"
                                    rows="6"
                                    placeholder="Nhập mô tả sản phẩm..."
                                )

                        .col-md-4
                            div(class="form-group")
                                label(for="price")
                                    i.fas.fa-dollar-sign(style="margin-right:5px;color:#10b981;font-size:12px;")
                                    | Giá ($)
                                input(
                                    type="number"
                                    class="form-control"
                                    id="price"
                                    name="price"
                                    value="0"
                                    min="0"
                                )

                            div(class="form-group")
                                label(for="discount")
                                    i.fas.fa-percent(style="margin-right:5px;color:#ef4444;font-size:12px;")
                                    | % Giảm giá
                                input(
                                    type="number"
                                    class="form-control"
                                    id="discount"
                                    name="discountPercentage"
                                    value="0"
                                    min="0"
                                )

                            div(class="form-group")
                                label(for="stock")
                                    i.fas.fa-warehouse(style="margin-right:5px;color:#3b82f6;font-size:12px;")
                                    | Số lượng tồn kho
                                input(
                                    type="number"
                                    class="form-control"
                                    id="stock"
                                    name="stock"
                                    value="0"
                                    min="0"
                                )

                            div(class="form-group" upload-image)
                                label(for="thumbnail")
                                    i.fas.fa-image(style="margin-right:5px;color:#115e59;font-size:12px;")
                                    | Hình ảnh
                                input(
                                    type="file"
                                    class="form-control"
                                    id="thumbnail"
                                    name="thumbnail"
                                    accept="image/*"
                                    upload-image-input
                                )
                                img(
                                    src=""
                                    class="image-preview"
                                    upload-image-preview
                                )
                                button(
                                    type="button"
                                    delete-image-button
                                    class="d-none"
                                )
                                    i.fas.fa-times
                                    |  Xóa ảnh

                            div(class="form-group")
                                label(for="position")
                                    i.fas.fa-sort-numeric-up(style="margin-right:5px;color:#5d6f69;font-size:12px;")
                                    | Vị trí
                                input(
                                    type="number"
                                    class="form-control"
                                    id="position"
                                    name="position"
                                    placeholder="Tự động tăng"
                                    min="1"
                                )

                            div(class="form-group")
                                label
                                    i.fas.fa-toggle-on(style="margin-right:5px;color:#10b981;font-size:12px;")
                                    | Trạng thái
                                div(style="display:flex;gap:20px;margin-top:6px;")
                                    label(style="display:flex;align-items:center;gap:6px;cursor:pointer;")
                                        input(
                                            type="radio"
                                            class="form-check-input"
                                            id="statusActive"
                                            name="status"
                                            value="active"
                                            checked
                                            style="margin:0;"
                                        )
                                        span(style="color:#10b981;font-weight:500;") Hoạt động
                                    label(style="display:flex;align-items:center;gap:6px;cursor:pointer;")
                                        input(
                                            type="radio"
                                            class="form-check-input"
                                            id="statusInActive"
                                            name="status"
                                            value="inactive"
                                            style="margin:0;"
                                        )
                                        span(style="color:#ef4444;font-weight:500;") Dừng hoạt động

                    .row.mt-3
                        .col-12
                            button(
                                type="submit"
                                class="btn btn-primary button-sumbit"
                            )
                                i.fas.fa-save
                                | Tạo mới sản phẩm

                script(src="/admin/js/product.js")