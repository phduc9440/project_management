header.header
    .container-fluid
        .row.align-items-center
            .col-4
                button.menu-toggle(type="button" aria-label="Mở menu" data-menu-toggle)
                    i.fas.fa-bars
                .inner-logo
                    a(href=`${prefixAdmin}/dasboard`)
                        i.fas.fa-layer-group(style="margin-right:8px;")
                        | AdminPanel
            .col-8
                .inner-actions
                    a(
                        href=`${prefixAdmin}/my-account`
                        class="btn-header btn-user"
                    )
                        i.fas.fa-user-circle
                        | #{user.fullName}
                    a(
                        href=`${prefixAdmin}/auth/logout`
                        class="btn-header btn-logout"
                    )
                        i.fas.fa-sign-out-alt
                        | Đăng xuất