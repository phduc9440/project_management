doctype html 
html(lang="vi")
    head 
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title #{pageTitle} | Admin Panel

        //- Google Fonts
        link(rel="preconnect" href="https://fonts.googleapis.com")
        link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
        link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Bricolage+Grotesque:opsz,wght@12..96,500;600;700;800&display=swap")

        //- Font Awesome
        link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css")

        //- Bootstrap 4
        link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css")

        //- Admin CSS
        link(rel="stylesheet" href="/admin/css/style.css")
    
    body 

        if (role.permissions.length > 0)
            include ../partials/header.pug

            .body 

                include ../partials/sider.pug

                .main 
                    block main

            //- Bootstrap JS
            script(src="https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.slim.min.js") 
            script(src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js") 

            //- TinyMCE
            script(src="/tinymce/tinymce.min.js")
            script(src="/admin/js/tinymce-config.js") 
        
            script(src="/admin/js/script.js")

        else 
            .d-flex.align-items-center.justify-content-center(style="min-height:100vh;background:#10201c;")
                .text-center
                    i.fas.fa-ban(style="font-size:48px;color:#ef4444;margin-bottom:16px;display:block;")
                    h2(style="color:#f6f8f7;font-weight:700;") Không có quyền truy cập
                    p(style="color:#5d6f69;") Bạn không có quyền để xem trang này.