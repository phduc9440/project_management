mixin product-item(item)
    .col-lg-3.col-md-4.col-6.mb-4
        .product-item
            a(href=`/products/detail/${item.slug}` class="product-item-link")
                .inner-image
                    img(
                        src=item.thumbnail
                        alt=item.title
                        loading="lazy"
                    )
                    if (item.featured == "1")
                        .inner-featured
                            i.fas.fa-star(style="font-size:10px;margin-right:3px;")
                            | Nổi bật
                    if (item.discountPercentage > 0)
                        .inner-badge-discount -#{item.discountPercentage}%
            .inner-content
                a(href=`/products/detail/${item.slug}`)
                    h3.inner-title #{item.title}
                .inner-pricing
                    span.inner-price-new #{item.priceNew}$
                    if (item.discountPercentage > 0)
                        span.inner-price-old #{item.price}$
                a(href=`/products/detail/${item.slug}` class="view-detail-btn-wrapper")
                    .view-detail-btn
                        i.fas.fa-shopping-cart
                        |  Xem chi tiết