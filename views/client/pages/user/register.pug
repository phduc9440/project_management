extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main
    .container.my-5
        .row.justify-content-center
            .col-md-6.col-lg-5
                .form-auth-card
                    .text-center.mb-4
                        i.fas.fa-user-plus(style="font-size:40px;color:#6366f1;")
                    h1 Tạo tài khoản

                    form(action="/user/register" method="POST")
                        div(class="form-group")
                            label(for="fullName")
                                i.fas.fa-user(style="margin-right:5px;font-size:12px;color:#6366f1;")
                                | Họ và tên
                            input(
                                type="text"
                                class="form-control"
                                id="fullName"
                                name="fullName"
                                placeholder="Nguyễn Văn A"
                                required
                            )
                        div(class="form-group")
                            label(for="email")
                                i.fas.fa-envelope(style="margin-right:5px;font-size:12px;color:#6366f1;")
                                | Email
                            input(
                                type="email"
                                class="form-control"
                                id="email"
                                name="email"
                                placeholder="you@example.com"
                                required
                            )
                        div(class="form-group")
                            label(for="password")
                                i.fas.fa-lock(style="margin-right:5px;font-size:12px;color:#6366f1;")
                                | Mật khẩu
                            input(
                                type="password"
                                class="form-control"
                                id="password"
                                name="password"
                                placeholder="Tối thiểu 6 ký tự"
                                required
                            )
                        div(class="form-group" style="margin-top:8px;")
                            button(
                                type="submit"
                                class="btn btn-primary btn-block"
                            )
                                i.fas.fa-user-plus(style="margin-right:6px;")
                                | Đăng ký

                    .auth-links
                        a(href="/user/login")
                            i.fas.fa-sign-in-alt(style="margin-right:4px;")
                            | Đã có tài khoản? Đăng nhập