nav.users-tabs
    a.users-tab(href="/users/not-friend") Người dùng
    a.users-tab(href="/users/friends") Bạn bè
    a.users-tab(href="/users/request") Đã gửi lời mời
    a.users-tab(href="/users/accept")
        | Lời mời kết bạn
        span.users-tab-count(badge-users-accept=user.id) #{user.acceptFriends.length}
script.
    document.querySelectorAll('.users-tab').forEach(function (a) {
        if (a.getAttribute('href') === location.pathname) a.classList.add('active');
    });
